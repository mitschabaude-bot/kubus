import equiv

data Nat : U := zero | suc (n : Nat)

def add (m : Nat) : Nat -> Nat
  | zero => m
  | suc n => suc (add m n)

def addZero : (n : Nat) -> Path Nat (add zero n) n
  | zero => \i -> zero
  | suc n => \i -> suc (addZero n i)

data Int : U := pos (n : Nat) | negsuc (n : Nat)

def sucInt : Int -> Int
  | pos n => pos (suc n)
  | negsuc zero => pos zero
  | negsuc (suc n) => negsuc n

def predInt : Int -> Int
  | pos zero => negsuc zero
  | pos (suc n) => pos n
  | negsuc n => negsuc (suc n)

def sucPred : (z : Int) -> Path Int (sucInt (predInt z)) z
  | pos zero => \i -> pos zero
  | pos (suc n) => \i -> pos (suc n)
  | negsuc n => \i -> negsuc n

def predSuc : (z : Int) -> Path Int (predInt (sucInt z)) z
  | pos n => \i -> pos n
  | negsuc zero => \i -> negsuc zero
  | negsuc (suc n) => \i -> negsuc (suc n)

def sucPathInt : Path U Int Int := isoToPath sucInt predInt sucPred predSuc
