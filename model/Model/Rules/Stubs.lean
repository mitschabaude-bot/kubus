  exact ⟨h0.1, h1.2.1, fun m ρ γ hp => (h0.2.2 m ρ γ hp).trans (h1.2.2 m ρ γ hp)⟩

theorem sem_EqTm_conv {S : Sig} {Ψ Φ Γ t u A B l}
    (h0 : SemEq S Ψ Φ Γ t u A) (h1 : SemEq S Ψ Φ Γ A B (univ l)) :
    SemEq S Ψ Φ Γ t u B := by
  exact ⟨sem_HasTy_conv h0.1 h1, sem_HasTy_conv h0.2.1 h1, h0.2.2⟩

theorem sem_EqTm_restrict {S : Sig} {Ψ Φ Φ' Γ t u A}
    (h0 : Φ'.Scoped Ψ) (h1 : I.Entails Φ' Φ) (h2 : SemEq S Ψ Φ Γ t u A) :
    SemEq S Ψ Φ' Γ t u A := by
  exact ⟨sem_HasTy_restrict h0 h1 h2.1, sem_HasTy_restrict h0 h1 h2.2.1,
    fun m ρ γ hp => h2.2.2 m ρ γ (hp.of_entails h1)⟩

theorem sem_EqTm_cumul {S : Sig} {Ψ Φ Γ A B l}
    (h0 : l + 1 ≤ maxLevel) (h1 : SemEq S Ψ Φ Γ A B (univ l)) :
    SemEq S Ψ Φ Γ A B (univ (l + 1)) := by
  exact ⟨sem_HasTy_cumul h0 h1.1, sem_HasTy_cumul h0 h1.2.1, h1.2.2⟩

theorem sem_EqTm_wk {S : Sig} {Ψ Φ Γ t u A B l}
    (h0 : SemTy S Ψ Φ Γ B (univ l)) (h1 : SemEq S Ψ Φ Γ t u A) :
    SemEq S Ψ Φ (B :: Γ) t.shift u.shift A.shift := by
  refine ⟨sem_HasTy_wk h0 h1.1, sem_HasTy_wk h0 h1.2.1, fun m ρ γ hp => ?_⟩
  obtain ⟨hpt, -⟩ := hp.tail
  rw [TEnv.eq_cons γ, sem_shift, sem_shift]; exact h1.2.2 m ρ _ hpt

theorem sem_EqTm_dwk {S : Sig} {Ψ Φ Γ t u A}
    (h0 : SemEq S Ψ Φ Γ t u A) :
    SemEq S (Ψ + 1) Φ.shift Γ.dshift t.dshift u.dshift A.dshift := by
  refine ⟨sem_HasTy_dwk h0.1, sem_HasTy_dwk h0.2.1, fun m ρ γ hp => ?_⟩
  rw [sem_dshift_tail, sem_dshift_tail]; exact h0.2.2 m ρ.tail γ (isPoint_dshift_iff.1 hp)

theorem sem_EqTm_subst {S : Sig} {Ψ Φ Γ A B t t' a a'}
    (h0 : SemEq S Ψ Φ (A :: Γ) t t' B) (h1 : SemEq S Ψ Φ Γ a a' A) :
    SemEq S Ψ Φ Γ (t.inst a) (t'.inst a') (B.inst a) := by
  refine ⟨sem_HasTy_subst h0.1 h1.1, ?_, fun m ρ γ hp => ?_⟩
  · refine (sem_HasTy_subst h0.2.1 h1.2.1).retype (h0.1.2.2.1.inst h1.1.2.1) fun m ρ γ hp => ?_
    obtain ⟨-, hanat, -, -⟩ := h1.1.2.2.2 m ρ γ hp
    obtain ⟨-, hanat', -, -⟩ := h1.2.1.2.2.2 m ρ γ hp
    rw [sem_inst hanat, sem_inst hanat', h1.2.2 m ρ γ hp]
  · obtain ⟨hamem, hanat, haty, -⟩ := h1.1.2.2.2 m ρ γ hp
    obtain ⟨-, hanat', -, -⟩ := h1.2.1.2.2.2 m ρ γ hp
    rw [sem_inst hanat, sem_inst hanat', h0.2.2 m ρ _ (hp.cons hamem (haty.fib.elKV _ _ _ hamem)),
      h1.2.2 m ρ γ hp]

theorem sem_EqTm_dsubst {S : Sig} {Ψ Φ Γ t t' A r}
    (h0 : SemEq S (Ψ + 1) Φ.shift Γ.dshift t t' A) (h1 : r.Scoped Ψ) :
    SemEq S Ψ Φ Γ (t.dinst r) (t'.dinst r) (A.dinst r) := by
  refine ⟨sem_HasTy_dsubst h0.1 h1, sem_HasTy_dsubst h0.2.1 h1, fun m ρ γ hp => ?_⟩
  rw [sem_dinst, sem_dinst]; exact h0.2.2 m _ γ (isPoint_dshift_iff.2 hp)

theorem sem_EqTm_delta {S : Sig} {Ψ Φ Γ k t A}
    (hS : SigOK S) (h0 : SemTy S Ψ Φ Γ (const k) A) (h1 : S[k]? = some (t, A)) :
    SemEq S Ψ Φ Γ (const k) t A := by
  obtain ⟨-, ht, -, -, hsem⟩ := hS.const h1
  refine ⟨h0, hS.const_sem h1 h0.1 _ (fun m ρ γ => (hsem m ρ γ).2.1) (ht.mono (hS.const h1).1.le),
    fun m ρ γ _ => by rw [(hsem m ρ γ).1, (hsem m ρ γ).2.1]⟩

theorem sem_EqTm_absurd {S : Sig} {Ψ Φ Γ t u A}
    (h0 : I.Entails Φ .zero) (h1 : SemTy S Ψ Φ Γ t A) (h2 : SemTy S Ψ Φ Γ u A) :
    SemEq S Ψ Φ Γ t u A := by
  exact ⟨h1, h2, fun m ρ γ hp => absurd (entails_holds h0 hp.cof) not_holds_zero⟩

theorem sem_EqTm_local {S : Sig} {Ψ Φ Γ φ ψ t u A}
    (h0 : φ.Scoped Ψ) (h1 : ψ.Scoped Ψ) (h2 : I.Entails Φ (.or φ ψ)) (h3 : SemTy S Ψ Φ Γ t A) (h4 : SemTy S Ψ Φ Γ u A) (h5 : SemEq S Ψ (cof Φ φ) Γ t u A) (h6 : SemEq S Ψ (cof Φ ψ) Γ t u A) :
    SemEq S Ψ Φ Γ t u A := by
  refine ⟨h3, h4, fun m ρ γ hp => ?_⟩
  rcases holds_or (entails_holds h2 hp.cof) with h | h
  · exact h5.2.2 m ρ γ (isPoint_cof_iff.2 ⟨hp, h⟩)
  · exact h6.2.2 m ρ γ (isPoint_cof_iff.2 ⟨hp, h⟩)

theorem sem_EqTm_face {S : Sig} {Ψ Φ Γ t A i d}
    (h0 : i < Ψ) (h1 : I.Entails Φ (I.lit i d)) (h2 : SemTy S Ψ Φ Γ t A) :
    SemEq S Ψ Φ Γ t (t.dset i (I.ofDir d)) A := by
  have he : ∀ m (ρ : IEnv m) γ, IsPoint S Φ Γ m ρ γ → sem S (t.dset i (I.ofDir d)) m ρ γ = sem S t m ρ γ := by
    intro m ρ γ hp
    rw [sem_dset]
    congr 1; funext n; split
    · subst n; exact (holds_lit (entails_holds h1 hp.cof)).symm
    · rfl
  exact ⟨h2, h2.of_eq (h2.2.1.dsubst _) he, fun m ρ γ hp => (he m ρ γ hp).symm⟩

theorem sem_EqTm_pi {S : Sig} {Ψ Φ Γ A A' B B' l}
    (h0 : SemEq S Ψ Φ Γ A A' (univ l)) (h1 : SemEq S Ψ Φ (A :: Γ) B B' (univ l)) :
    SemEq S Ψ Φ Γ (pi A B) (pi A' B') (univ l) := by
  have h1' : SemTy S Ψ Φ (A' :: Γ) B' (univ l) := h1.2.1.ctx_conv h0
  refine ⟨sem_HasTy_pi h0.1 h1.1, sem_HasTy_pi h0.2.1 h1', fun m ρ γ hp => ?_⟩
  obtain ⟨hAmem, hAnat, -, -⟩ := h0.1.2.2.2 m ρ γ hp
  obtain ⟨hAty, -⟩ := h0.1.ty_at hp
  have hAkv : IsKV m (sem S A m ρ γ) := hAty.fib.kv
  have hAeq := h0.2.2 m ρ γ hp
  rw [sem_pi hAkv, sem_pi (hAeq ▸ hAkv), ← hAeq]
  congr 1; unfold famV lamV; congr 1; funext k g
  apply fnZ_congr; intro x hx
  exact h1.2.2 k _ _ (hp.ext h0.1.1 hAty hAnat g hx)

theorem sem_EqTm_lam {S : Sig} {Ψ Φ Γ A B t t' l}
    (h0 : SemTy S Ψ Φ Γ (pi A B) (univ l)) (h1 : SemEq S Ψ Φ (A :: Γ) t t' B) :
    SemEq S Ψ Φ Γ (lam A t) (lam A t') (pi A B) := by
  refine ⟨sem_HasTy_lam h0 h1.1, sem_HasTy_lam h0 h1.2.1, fun m ρ γ hp => ?_⟩
  obtain ⟨hAty, hAnat⟩ := h0.piDom.ty_at hp
  rw [sem_lam, sem_lam]
  unfold lamV; congr 1; funext k g
  apply fnZ_congr; intro x hx
  exact h1.2.2 k _ _ (hp.ext h0.1 hAty hAnat g hx)

theorem sem_EqTm_app {S : Sig} {Ψ Φ Γ A B f f' a a'}
    (h0 : SemEq S Ψ Φ Γ f f' (pi A B)) (h1 : SemEq S Ψ Φ Γ a a' A) :
    SemEq S Ψ Φ Γ (app f a) (app f' a') (B.inst a) := by
  refine ⟨sem_HasTy_app h0.1 h1.1, (sem_HasTy_app h0.2.1 h1.2.1).retype
    (h0.1.2.2.1.2.inst h1.1.2.1) (fun m ρ γ hp => ?_), fun m ρ γ hp => ?_⟩
  · obtain ⟨-, hanat, -, -⟩ := h1.1.2.2.2 m ρ γ hp
    obtain ⟨-, hanat', -, -⟩ := h1.2.1.2.2.2 m ρ γ hp
    rw [sem_inst hanat, sem_inst hanat', h1.2.2 m ρ γ hp]
  · obtain ⟨-, hanat, -, -⟩ := h1.1.2.2.2 m ρ γ hp
    obtain ⟨-, hanat', -, -⟩ := h1.2.1.2.2.2 m ρ γ hp
    rw [sem_app_of_nat hanat, sem_app_of_nat hanat', h0.2.2 m ρ γ hp, h1.2.2 m ρ γ hp]

theorem sem_EqTm_sigma {S : Sig} {Ψ Φ Γ A A' B B' l}
    (h0 : SemEq S Ψ Φ Γ A A' (univ l)) (h1 : SemEq S Ψ Φ (A :: Γ) B B' (univ l)) :
    SemEq S Ψ Φ Γ (sigma A B) (sigma A' B') (univ l) := by
  have h1' : SemTy S Ψ Φ (A' :: Γ) B' (univ l) := h1.2.1.ctx_conv h0
  refine ⟨sem_HasTy_sigma h0.1 h1.1, sem_HasTy_sigma h0.2.1 h1', fun m ρ γ hp => ?_⟩
  obtain ⟨hAmem, hAnat, -, -⟩ := h0.1.2.2.2 m ρ γ hp
  obtain ⟨hAty, -⟩ := h0.1.ty_at hp
  have hAkv : IsKV m (sem S A m ρ γ) := hAty.fib.kv
  have hAeq := h0.2.2 m ρ γ hp
  rw [sem_sigma hAkv, sem_sigma (hAeq ▸ hAkv), ← hAeq]
  congr 1; unfold famV lamV; congr 1; funext k g
  apply fnZ_congr; intro x hx
  exact h1.2.2 k _ _ (hp.ext h0.1.1 hAty hAnat g hx)

theorem sem_EqTm_pair {S : Sig} {Ψ Φ Γ A B a a' b b' l}
    (h0 : SemTy S Ψ Φ Γ (sigma A B) (univ l)) (h1 : SemEq S Ψ Φ Γ a a' A) (h2 : SemEq S Ψ Φ Γ b b' (B.inst a)) :
    SemEq S Ψ Φ Γ (pair a b) (pair a' b') (sigma A B) := by
  have hb' : SemTy S Ψ Φ Γ b' (B.inst a') := h2.2.1.retype (h0.2.1.2.inst h1.2.1.2.1) fun m ρ γ hp => by
    obtain ⟨-, hanat, -, -⟩ := h1.1.2.2.2 m ρ γ hp
    obtain ⟨-, hanat', -, -⟩ := h1.2.1.2.2.2 m ρ γ hp
    rw [sem_inst hanat, sem_inst hanat', h1.2.2 m ρ γ hp]
  refine ⟨sem_HasTy_pair h0 h1.1 h2.1, sem_HasTy_pair h0 h1.2.1 hb', fun m ρ γ hp => ?_⟩
  simp only [sem, interp]
  rw [show interp (cstFn S) univC TyCode a m ρ γ = interp (cstFn S) univC TyCode a' m ρ γ from h1.2.2 m ρ γ hp,
    show interp (cstFn S) univC TyCode b m ρ γ = interp (cstFn S) univC TyCode b' m ρ γ from h2.2.2 m ρ γ hp]

theorem sem_EqTm_fst {S : Sig} {Ψ Φ Γ A B p p'}
    (h0 : SemEq S Ψ Φ Γ p p' (sigma A B)) :
    SemEq S Ψ Φ Γ (fst p) (fst p') A := by
  refine ⟨sem_HasTy_fst h0.1, sem_HasTy_fst h0.2.1, fun m ρ γ hp => ?_⟩
  rw [sem_fst, sem_fst, h0.2.2 m ρ γ hp]

theorem sem_EqTm_snd {S : Sig} {Ψ Φ Γ A B p p'}
    (h0 : SemEq S Ψ Φ Γ p p' (sigma A B)) :
    SemEq S Ψ Φ Γ (snd p) (snd p') (B.inst (fst p)) := by
  refine ⟨sem_HasTy_snd h0.1, (sem_HasTy_snd h0.2.1).retype (h0.1.2.2.1.2.inst h0.1.2.1)
    (fun m ρ γ hp => ?_), fun m ρ γ hp => ?_⟩
  · have hf := (sem_HasTy_fst h0.1).2.2.2 m ρ γ hp
    have hf' := (sem_HasTy_fst h0.2.1).2.2.2 m ρ γ hp
    rw [sem_inst hf.2.1, sem_inst hf'.2.1, sem_fst, sem_fst, h0.2.2 m ρ γ hp]
  · rw [sem_snd, sem_snd, h0.2.2 m ρ γ hp]

theorem sem_EqTm_path {S : Sig} {Ψ Φ Γ A A' a a' b b' l}
    (h0 : SemEq S (Ψ + 1) Φ.shift Γ.dshift A A' (univ l)) (h1 : SemEq S Ψ Φ Γ a a' (A.dinst .zero)) (h2 : SemEq S Ψ Φ Γ b b' (A.dinst .one)) :
    SemEq S Ψ Φ Γ (path A a b) (path A' a' b') (univ l) := by
  have hwf : SemWf S Ψ Φ Γ := h1.1.1
  have hd : ∀ (r : I) m (ρ : IEnv m) γ, IsPoint S Φ Γ m ρ γ →
      sem S (A.dinst r) m ρ γ = sem S (A'.dinst r) m ρ γ := fun r m ρ γ hp => by
    rw [sem_dinst, sem_dinst]; exact h0.2.2 m _ _ (isPoint_cons_iff.2 hp)
  have ha' := h1.2.1.retype (h0.2.1.2.1.dinst _) (hd .zero)
  have hb' := h2.2.1.retype (h0.2.1.2.1.dinst _) (hd .one)
  refine ⟨sem_HasTy_path h0.1 h1.1 h2.1, sem_HasTy_path h0.2.1 ha' hb', fun m ρ γ hp => ?_⟩
  have hpe := hp.dext hwf
  have eA : ∀ k (g : Hom k (m + 1)),
      interp (cstFn S) univC TyCode A k (ρ.ext.restr g) (TEnv.restr (TEnv.restr γ (Hom.wk m)) g) =
      interp (cstFn S) univC TyCode A' k (ρ.ext.restr g) (TEnv.restr (TEnv.restr γ (Hom.wk m)) g) :=
    fun k g => h0.2.2 k _ _ (hpe.restr h0.1.1 g)
  have eA0 : interp (cstFn S) univC TyCode A (m + 1) ρ.ext (TEnv.restr γ (Hom.wk m)) =
      interp (cstFn S) univC TyCode A' (m + 1) ρ.ext (TEnv.restr γ (Hom.wk m)) := h0.2.2 _ _ _ hpe
  have ea : interp (cstFn S) univC TyCode a m ρ γ = interp (cstFn S) univC TyCode a' m ρ γ :=
    h1.2.2 m ρ γ hp
  have eb : interp (cstFn S) univC TyCode b m ρ γ = interp (cstFn S) univC TyCode b' m ρ γ :=
    h2.2.2 m ρ γ hp
  simp only [sem, interp, eA, eA0, ea, eb]

theorem sem_EqTm_plam {S : Sig} {Ψ Φ Γ A a b t t' l}
    (h0 : SemTy S Ψ Φ Γ (path A a b) (univ l)) (h1 : SemTy S Ψ Φ Γ (plam t) (path A a b)) (h2 : SemTy S Ψ Φ Γ (plam t') (path A a b)) (h3 : SemEq S (Ψ + 1) Φ.shift Γ.dshift t t' A) :
    SemEq S Ψ Φ Γ (plam t) (plam t') (path A a b) := by
  refine ⟨h1, h2, fun m ρ γ hp => ?_⟩
  have hpe := hp.dext h0.1
  rw [sem_plam (h3.1.2.2.2 _ _ _ hpe).2.1, sem_plam (h3.2.1.2.2.2 _ _ _ hpe).2.1]
  unfold lineV; rw [h3.2.2 _ _ _ hpe]

theorem sem_EqTm_papp {S : Sig} {Ψ Φ Γ A a b p p' r r'}
    (h0 : SemEq S Ψ Φ Γ p p' (path A a b)) (h1 : r.Scoped Ψ) (h2 : r'.Scoped Ψ) (h3 : I.Eq r r') :
    SemEq S Ψ Φ Γ (papp p r) (papp p' r') (A.dinst r) := by
  refine ⟨sem_HasTy_papp h0.1 h1, (sem_HasTy_papp h0.2.1 h2).retype (h0.1.2.2.1.1.dinst _)
    (fun m ρ γ hp => by rw [sem_dinst, sem_dinst, ival.congr_eq h3]), fun m ρ γ hp => ?_⟩
  rw [sem_papp, sem_papp, h0.2.2 m ρ γ hp, ival.congr_eq h3]

theorem sem_EqTm_split {S : Sig} {Ψ Φ Γ A φ ψ t t' u u'}
    (h0 : SemTy S Ψ Φ Γ (split φ t ψ u) A) (h1 : SemTy S Ψ Φ Γ (split φ t' ψ u') A) (h2 : SemEq S Ψ (cof Φ φ) Γ t t' A) (h3 : SemEq S Ψ (cof Φ ψ) Γ u u' A) :
    SemEq S Ψ Φ Γ (split φ t ψ u) (split φ t' ψ u') A := by
  refine ⟨h0, h1, fun m ρ γ hp => ?_⟩
  obtain ⟨hmem, -, hty, -⟩ := h0.2.2.2 m ρ γ hp
  obtain ⟨hmem', -, hty', -⟩ := h1.2.2.2 m ρ γ hp
  rcases sem_split_cases (hty.ne_empty hmem) with ⟨hφ, e1, -⟩ | ⟨hφ, hψ, e1⟩ <;>
    rcases sem_split_cases (hty'.ne_empty hmem') with ⟨hφ', e2, -⟩ | ⟨hφ', hψ', e2⟩
  · rw [e1, e2]; exact h2.2.2 m ρ γ (isPoint_cof_iff.2 ⟨hp, hφ⟩)
  · exact absurd hφ hφ'
  · exact absurd hφ' hφ
  · rw [e1, e2]; exact h3.2.2 m ρ γ (isPoint_cof_iff.2 ⟨hp, hψ⟩)

theorem sem_EqTm_transp {S : Sig} {Ψ Φ Γ A A' φ φ' a a' l}
    (h0 : SemTy S Ψ Φ Γ (transp A φ a) (A.dinst .one)) (h1 : SemTy S Ψ Φ Γ (transp A' φ' a') (A.dinst .one)) (h2 : SemEq S (Ψ + 1) Φ.shift Γ.dshift A A' (univ l)) (h3 : I.Entails φ φ') (h4 : I.Entails φ' φ) (h5 : SemEq S Ψ Φ Γ a a' (A.dinst .zero)) :
    SemEq S Ψ Φ Γ (transp A φ a) (transp A' φ' a') (A.dinst .one) := by
  refine ⟨h0, h1, fun m ρ γ hp => ?_⟩
  have eL : interp (cstFn S) univC TyCode A (m + 1) ρ.ext (TEnv.restr γ (Hom.wk m)) =
      interp (cstFn S) univC TyCode A' (m + 1) ρ.ext (TEnv.restr γ (Hom.wk m)) :=
    h2.2.2 _ _ _ (hp.dext h0.1)
  have ea : interp (cstFn S) univC TyCode a m ρ γ = interp (cstFn S) univC TyCode a' m ρ γ := h5.2.2 m ρ γ hp
  have eA : ∀ k (g : Hom k (m + 1)),
      interp (cstFn S) univC TyCode A k (ρ.ext.restr g) (TEnv.restr (TEnv.restr γ (Hom.wk m)) g) =
      interp (cstFn S) univC TyCode A' k (ρ.ext.restr g) (TEnv.restr (TEnv.restr γ (Hom.wk m)) g) :=
    fun k g => h2.2.2 k _ _ ((hp.dext h0.1).restr h2.1.1 g)
  have ea' : ∀ k (g : Hom k m), interp (cstFn S) univC TyCode a k (ρ.restr g) (TEnv.restr γ g) =
      interp (cstFn S) univC TyCode a' k (ρ.restr g) (TEnv.restr γ g) :=
    fun k g => h5.2.2 k _ _ (hp.restr h0.1 g)
  simp only [sem, interp, eL, ea, eA, ea', face_eq_of_entails h3 h4 ρ]

theorem sem_EqTm_hcomp {S : Sig} {Ψ Φ Γ A A' φ φ' u u' a a' l}
    (h0 : SemTy S Ψ Φ Γ (hcomp A φ u a) A) (h1 : SemTy S Ψ Φ Γ (hcomp A' φ' u' a') A) (h2 : SemEq S Ψ Φ Γ A A' (univ l)) (h3 : I.Entails φ φ') (h4 : I.Entails φ' φ) (h5 : SemEq S (Ψ + 1) (cof Φ φ).shift Γ.dshift u u' A.dshift) (h6 : SemEq S Ψ Φ Γ a a' A) :
    SemEq S Ψ Φ Γ (hcomp A φ u a) (hcomp A' φ' u' a') A := by
  refine ⟨h0, h1, fun m ρ γ hp => ?_⟩
  obtain ⟨hm0, -, hty0, -⟩ := h0.2.2.2 m ρ γ hp
  obtain ⟨hm1, -, hty1, -⟩ := h1.2.2.2 m ρ γ hp
  have hc := cond_of_sem_hcomp (hty0.ne_empty hm0)
  have hc' := cond_of_sem_hcomp (hty1.ne_empty hm1)
  rw [sem_hcomp hc, sem_hcomp hc', ← h2.2.2 m ρ γ hp, ← h6.2.2 m ρ γ hp, ← face_eq_of_entails h3 h4 ρ]
  apply hcompAt_congr
  intro n h r hh
  rw [holds_face_restr_iff] at hh
  exact h5.2.2 n _ _ (isPoint_dshift_iff.2 (isPoint_cof_iff.2 ⟨hp.restr h0.1 h, hh⟩))

theorem sem_EqTm_glue {S : Sig} {Ψ Φ Γ A A' φ φ' T T' e e' l}
    (h0 : SemTy S Ψ Φ Γ (glue A φ T e) (univ l)) (h1 : SemTy S Ψ Φ Γ (glue A' φ' T' e') (univ l)) (h2 : SemEq S Ψ Φ Γ A A' (univ l)) (h3 : I.Entails φ φ') (h4 : I.Entails φ' φ) (h5 : SemEq S Ψ (cof Φ φ) Γ T T' (univ l)) (h6 : SemEq S Ψ (cof Φ φ) Γ e e' (equiv T A)) :
