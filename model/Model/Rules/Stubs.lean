theorem sem_EqTm_piBeta {S : Sig} {Ψ Φ Γ A t a T}
    (h0 : SemTy S Ψ Φ Γ (app (lam A t) a) T) :
    SemEq S Ψ Φ Γ (app (lam A t) a) (t.inst a) T := by
  have he : ∀ m (ρ : IEnv m) γ, IsPoint S Φ Γ m ρ γ → sem S (t.inst a) m ρ γ = sem S (app (lam A t) a) m ρ γ := by
    intro m ρ γ hp
    obtain ⟨hmem, -, hty, -⟩ := h0.2.2.2 m ρ γ hp
    have hne := hty.ne_empty hmem
    have hanat := nat_of_sem_app hne
    rw [sem_app_of_nat hanat] at hne ⊢
    rw [sem_lam] at hne ⊢
    by_cases ha : sem S a m ρ γ ∈ El (sem S A m ρ γ) (Hom.id m)
    · rw [appV_lamV _ ha, sem_inst hanat, IEnv.restr_id, TEnv.restr_id_of_kv hp.kv]
    · exfalso; apply hne
      simp only [appV, here, dat_lamV]
      rw [apZ, dif_neg]
      rintro ⟨y, hy⟩; obtain ⟨x, hx, he⟩ := Model.mem_fnZ.1 hy
      rw [Model.pair_inj'] at he; exact ha (he.1 ▸ hx)
  exact ⟨h0, h0.of_eq (h0.2.1.1.2.inst h0.2.1.2) he, fun m ρ γ hp => (he m ρ γ hp).symm⟩

theorem sem_EqTm_piEta {S : Sig} {Ψ Φ Γ A B f}
    (h0 : SemTy S Ψ Φ Γ f (pi A B)) :
    SemEq S Ψ Φ Γ f (lam A (app f.shift (var 0))) (pi A B) := by
  have he : ∀ m (ρ : IEnv m) γ, IsPoint S Φ Γ m ρ γ →
      sem S (lam A (app f.shift (var 0))) m ρ γ = sem S f m ρ γ := by
    intro m ρ γ hp
    obtain ⟨hfmem, hfnat, hpiTy, -⟩ := h0.2.2.2 m ρ γ hp
    obtain ⟨hAkv, -⟩ := hpiTy.pi_at
    rw [sem_pi hAkv, El_piC, res_id hAkv, res_id (isKV_famV _ _)] at hfmem
    rw [sem_lam, eq_lamV_of_mem_piEl hfmem]
    unfold lamV; congr 1; funext k g
    apply fnZ_congr; intro x hx
    dsimp only
    rw [sem_app_of_nat (natural_var S 0 _ _), sem_shift, hfnat k g, sem_var, TEnv.cons_zero, appV_res]
  exact ⟨h0, h0.of_eq ⟨h0.2.2.1.1, h0.2.1.ren _ _, trivial⟩ he, fun m ρ γ hp => (he m ρ γ hp).symm⟩

theorem sem_EqTm_fstBeta {S : Sig} {Ψ Φ Γ a b T}
    (h0 : SemTy S Ψ Φ Γ (fst (pair a b)) T) :
    SemEq S Ψ Φ Γ (fst (pair a b)) a T := by
  have he : ∀ m (ρ : IEnv m) γ, IsPoint S Φ Γ m ρ γ → sem S a m ρ γ = sem S (fst (pair a b)) m ρ γ := by
    intro m ρ γ hp
    obtain ⟨hmem, -, hty, -⟩ := h0.2.2.2 m ρ γ hp
    have hne := hty.ne_empty hmem
    rw [sem_fst] at hne ⊢
    have hpne : sem S (pair a b) m ρ γ ≠ ∅ := fun h => hne (by rw [h, fstV_empty])
    obtain ⟨hakv, hbkv⟩ := kv_of_sem_pair hpne
    rw [sem_pair_of_kv hakv hbkv, fstV_pairV hakv]
  exact ⟨h0, h0.of_eq h0.2.1.1 he, fun m ρ γ hp => (he m ρ γ hp).symm⟩

theorem sem_EqTm_sndBeta {S : Sig} {Ψ Φ Γ a b T}
    (h0 : SemTy S Ψ Φ Γ (snd (pair a b)) T) :
