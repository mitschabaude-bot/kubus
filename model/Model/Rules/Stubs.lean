theorem sem_HasTy_hcomp {S : Sig} {Ψ Φ Γ A φ u a l}
    (h0 : SemTy S Ψ Φ Γ A (univ l)) (h1 : φ.Scoped Ψ) (h2 : SemTy S (Ψ + 1) (cof Φ φ).shift Γ.dshift u A.dshift) (h3 : SemTy S Ψ Φ Γ a A) (h4 : SemEq S Ψ (cof Φ φ) Γ (u.dinst .zero) a A) :
