theorem sem_HasTy_univ {S : Sig} {Ψ Φ Γ l}
    (h0 : l + 1 ≤ maxLevel) (h1 : SemWf S Ψ Φ Γ) :
    SemTy S Ψ Φ Γ (univ l) (univ (l + 1)) := by
  refine ⟨h1, trivial, trivial, fun m ρ γ hp => ?_⟩
  refine ⟨?_, fun k f => by simp [res_univC], ⟨l + 1, h0, Or.inr rfl⟩, fun k f => by simp [res_univC]⟩
  rw [sem_univ, sem_univ, El_univC, ZFSet.mem_sep]
  exact ⟨univC_mem_Vt (by simp [maxLevel] at h0; omega), wf_univC⟩

theorem sem_HasTy_cumul {S : Sig} {Ψ Φ Γ A l}
    (h0 : l + 1 ≤ maxLevel) (h1 : SemTy S Ψ Φ Γ A (univ l)) :
    SemTy S Ψ Φ Γ A (univ (l + 1)) := by
  refine ⟨h1.1, h1.2.1, trivial, fun m ρ γ hp => ?_⟩
  obtain ⟨hmem, hnat, -, -⟩ := h1.2.2.2 m ρ γ hp
  refine ⟨?_, hnat, ⟨l + 1, h0, Or.inr rfl⟩, fun k f => by simp [res_univC]⟩
  rw [sem_univ, El_univC, ZFSet.mem_sep] at hmem ⊢
  exact ⟨Vt_subset_succ l (by simp [maxLevel] at h0; omega) hmem.1, hmem.2.cumul⟩

theorem sem_HasTy_pi {S : Sig} {Ψ Φ Γ A B l}
    (h0 : SemTy S Ψ Φ Γ A (univ l)) (h1 : SemTy S Ψ Φ (A :: Γ) B (univ l)) :
    SemTy S Ψ Φ Γ (pi A B) (univ l) := by
  refine ⟨h0.1, ⟨h0.2.1, h1.2.1⟩, trivial, fun m ρ γ hp => ?_⟩
  obtain ⟨hAmem, hAnat, hUty, hUnat⟩ := h0.2.2.2 m ρ γ hp
  obtain ⟨hAty, -⟩ := h0.ty_at hp
  have hAfib := hAty.fib
  rw [sem_univ, mem_El_univ_iff] at hAmem
  have hBat : ∀ k (f : Hom k m) a, a ∈ El (sem S A m ρ γ) f →
      sem S B k (ρ.restr f) (TEnv.cons (TEnv.restr γ f) a) ∈ Vt l ∧
        WF l k (sem S B k (ρ.restr f) (TEnv.cons (TEnv.restr γ f) a)) := fun k f a ha => by
    have := (h1.2.2.2 k _ _ (hp.ext h0.1 hAty hAnat f ha)).1
    rwa [sem_univ, mem_El_univ_iff] at this
  have hAkv : IsKV m (sem S A m ρ γ) := (wf_props l m _ hAmem.2).1.kv
  refine ⟨?_, fun k f => ?_, hUty, hUnat⟩
  · rw [sem_univ, mem_El_univ_iff, sem_pi hAkv]
    constructor
    · exact piC_mem_Vt hAmem.1 fun k f a ha => by rw [apZ_dat_famV _ _ _ ha]; exact (hBat k f a ha).1
    · have hkv : IsKV m (famV m (sem S A m ρ γ) fun k f a => sem S B k (ρ.restr f) (TEnv.cons (TEnv.restr γ f) a)) := by
        unfold famV lamV; exact isKV_mkKV _
      unfold WF
      refine WFI.pi hAmem.2 hkv (fun k f => ?_) (fun k f a ha => ?_) (fun k f a ha n h => ?_)
      · rw [dat_famV]
        exact fnZ_congr fun a ha =>
          (apZ_fnZ (fun a => sem S B k (ρ.restr f) (TEnv.cons (TEnv.restr γ f) a)) ha).symm
      · rw [apZ_dat_famV _ _ _ ha]; exact (hBat k f a ha).2
      · rw [apZ_dat_famV _ _ _ ha, apZ_dat_famV _ _ _ (hAfib.elRes _ _ _ ha n h)]
        have := (h1.2.2.2 k _ _ (hp.ext h0.1 hAty hAnat f ha)).2.1 n h
        rw [← this, TEnv.restr_cons, TEnv.restr_restr]; rfl
  · rw [sem_pi hAkv, sem_pi (by rw [hAnat k f]; exact isKV_res _ _), res_piC, hAnat k f, res_famV]
    congr 1; unfold famV; congr 1
    funext k' g; funext a; rw [TEnv.restr_restr]; rfl

theorem sem_HasTy_lam {S : Sig} {Ψ Φ Γ A B t l}
    (h0 : SemTy S Ψ Φ Γ (pi A B) (univ l)) (h1 : SemTy S Ψ Φ (A :: Γ) t B) :
    SemTy S Ψ Φ Γ (lam A t) (pi A B) := by
  refine ⟨h0.1, ⟨h0.2.1.1, h1.2.1⟩, h0.2.1, fun m ρ γ hp => ?_⟩
  obtain ⟨hpimem, hpinat, hUty, -⟩ := h0.2.2.2 m ρ γ hp
  obtain ⟨hAkv, hsem, -, -⟩ := h0.pi_at hp
  obtain ⟨hAty, hAnat⟩ := h0.piDom.ty_at hp
  have hAfib := hAty.fib
  refine ⟨?_, fun k f => ?_, TyCode.of_mem_univ hUty hpimem, hpinat⟩
  · rw [hsem, El_piC, res_id hAkv, res_id (isKV_famV _ _), sem_lam]
    apply lamV_mem_piEl
    · intro n g a ha n' h; exact hAfib.elRes _ _ _ ha _ h
    · intro n g a ha
      rw [apZ_dat_famV _ _ _ ha]
      exact (h1.2.2.2 n _ _ (hp.ext h0.1 hAty hAnat g ha)).1
    · intro n g a ha n' h
      have := (h1.2.2.2 n _ _ (hp.ext h0.1 hAty hAnat g ha)).2.1 n' h
      rw [← this, TEnv.restr_cons, TEnv.restr_restr]; rfl
  · rw [sem_lam, sem_lam, res_lamV, hAnat k f]
    congr 1
    · funext n g; rw [El_res]
    · funext n g a; rw [TEnv.restr_restr]; rfl

theorem sem_HasTy_app {S : Sig} {Ψ Φ Γ A B f a}
    (h0 : SemTy S Ψ Φ Γ f (pi A B)) (h1 : SemTy S Ψ Φ Γ a A) :
    SemTy S Ψ Φ Γ (app f a) (B.inst a) := by
  refine ⟨h0.1, ⟨h0.2.1, h1.2.1⟩, h0.2.2.1.2.inst h1.2.1, fun m ρ γ hp => ?_⟩
  obtain ⟨hfmem, hfnat, hpiTy, hpinat⟩ := h0.2.2.2 m ρ γ hp
  obtain ⟨hamem, hanat, -, -⟩ := h1.2.2.2 m ρ γ hp
  obtain ⟨hAkv, l, hl, hV, hWF⟩ := hpiTy.pi_at
  rw [sem_pi hAkv] at hfmem hV hWF
  obtain ⟨-, hfam, hcoh⟩ := WF.pi_inv hAkv (isKV_famV _ _) hWF
  rw [El_piC, res_id hAkv, res_id (isKV_famV _ _)] at hfmem
  have hval : ∀ k (g : Hom k m) x, x ∈ El (sem S A m ρ γ) g →
      apZ (dat (famV m (sem S A m ρ γ) fun k f a => sem S B k (ρ.restr f) (TEnv.cons (TEnv.restr γ f) a)) k g) x =
      sem S B k (ρ.restr g) (TEnv.cons (TEnv.restr γ g) x) := fun k g x hx => apZ_dat_famV _ _ _ hx
  have hBi : sem S (B.inst a) m ρ γ = apZ (dat (famV m (sem S A m ρ γ) fun k f a =>
      sem S B k (ρ.restr f) (TEnv.cons (TEnv.restr γ f) a)) m (Hom.id m)) (sem S a m ρ γ) := by
    rw [hval m _ _ hamem, sem_inst hanat, IEnv.restr_id, TEnv.restr_id_of_kv hp.kv]
  refine ⟨?_, fun k g => ?_, ?_, fun k g => ?_⟩
  · rw [sem_app_of_nat hanat, hBi]
    have := appV_mem_piElSet hfmem hamem
    exact this
  · rw [sem_app_of_nat (hanat.restr g), sem_app_of_nat hanat, hfnat k g, hanat k g]
    exact (res_appV hfmem hamem g).symm
  · unfold TyOK; rw [hBi]
    exact ⟨l, hl, Or.inl ⟨hfam m _ _ hamem, Vt_below (below_piC_fam _ _ (isKV_famV _ _) _
      ⟨_, by rw [dat_famV]; exact Model.mem_fnZ.2 ⟨_, hamem, rfl⟩⟩) hV⟩⟩
  · have hga : res g (sem S a m ρ γ) ∈ El (sem S A m ρ γ) g := by
      have := hpiTy.fib.elRes; exact (by
        have h' := (TyCode.fib (TyCode.of_mem_univ (l := l) ⟨l, hl, Or.inr rfl⟩ (mem_El_univ_iff.2 ⟨Vt_below
          (below_piC_dom _ _ hAkv) hV, (WF.pi_inv hAkv (isKV_famV _ _) hWF).1⟩))).elRes _ _ _ hamem k g
        rwa [Hom.id_comp] at h')
    rw [sem_inst (hanat.restr g), hBi, hcoh m _ _ hamem k g, Hom.id_comp, hval k g _ hga, hanat k g]

theorem sem_HasTy_sigma {S : Sig} {Ψ Φ Γ A B l}
    (h0 : SemTy S Ψ Φ Γ A (univ l)) (h1 : SemTy S Ψ Φ (A :: Γ) B (univ l)) :
    SemTy S Ψ Φ Γ (sigma A B) (univ l) := by
  refine ⟨h0.1, ⟨h0.2.1, h1.2.1⟩, trivial, fun m ρ γ hp => ?_⟩
  obtain ⟨hAmem, hAnat, hUty, hUnat⟩ := h0.2.2.2 m ρ γ hp
  obtain ⟨hAty, -⟩ := h0.ty_at hp
  have hAfib := hAty.fib
  rw [sem_univ, mem_El_univ_iff] at hAmem
  have hBat : ∀ k (f : Hom k m) a, a ∈ El (sem S A m ρ γ) f →
      sem S B k (ρ.restr f) (TEnv.cons (TEnv.restr γ f) a) ∈ Vt l ∧
        WF l k (sem S B k (ρ.restr f) (TEnv.cons (TEnv.restr γ f) a)) := fun k f a ha => by
    have := (h1.2.2.2 k _ _ (hp.ext h0.1 hAty hAnat f ha)).1
    rwa [sem_univ, mem_El_univ_iff] at this
  have hAkv : IsKV m (sem S A m ρ γ) := (wf_props l m _ hAmem.2).1.kv
  refine ⟨?_, fun k f => ?_, hUty, hUnat⟩
  · rw [sem_univ, mem_El_univ_iff, sem_sigma hAkv]
    constructor
    · exact sigmaC_mem_Vt hAmem.1 fun k f a ha => by rw [apZ_dat_famV _ _ _ ha]; exact (hBat k f a ha).1
    · unfold WF
      refine WFI.sigma hAmem.2 (isKV_famV _ _) (fun k f => ?_) (fun k f a ha => ?_) (fun k f a ha n h => ?_)
      · rw [dat_famV]
        exact fnZ_congr fun a ha =>
          (apZ_fnZ (fun a => sem S B k (ρ.restr f) (TEnv.cons (TEnv.restr γ f) a)) ha).symm
      · rw [apZ_dat_famV _ _ _ ha]; exact (hBat k f a ha).2
      · rw [apZ_dat_famV _ _ _ ha, apZ_dat_famV _ _ _ (hAfib.elRes _ _ _ ha n h)]
        have := (h1.2.2.2 k _ _ (hp.ext h0.1 hAty hAnat f ha)).2.1 n h
        rw [← this, TEnv.restr_cons, TEnv.restr_restr]; rfl
  · rw [sem_sigma hAkv, sem_sigma (by rw [hAnat k f]; exact isKV_res _ _), res_sigmaC, hAnat k f, res_famV]
    congr 1; unfold famV; congr 1
    funext k' g; funext a; rw [TEnv.restr_restr]; rfl

theorem sem_HasTy_pair {S : Sig} {Ψ Φ Γ A B a b l}
    (h0 : SemTy S Ψ Φ Γ (sigma A B) (univ l)) (h1 : SemTy S Ψ Φ Γ a A) (h2 : SemTy S Ψ Φ Γ b (B.inst a)) :
    SemTy S Ψ Φ Γ (pair a b) (sigma A B) := by
  refine ⟨h1.1, ⟨h1.2.1, h2.2.1⟩, h0.2.1, fun m ρ γ hp => ?_⟩
  obtain ⟨hsmem, hsnat, hUty, -⟩ := h0.2.2.2 m ρ γ hp
  have hsTy : TyOK S (sigma A B) m ρ γ := TyCode.of_mem_univ hUty hsmem
  obtain ⟨hAkv, hsem, hAfib, hfam, -⟩ := hsTy.sigma_data
  obtain ⟨hamem, hanat, haty, -⟩ := h1.2.2.2 m ρ γ hp
  obtain ⟨hbmem, hbnat, hbty, -⟩ := h2.2.2.2 m ρ γ hp
  have hakv := haty.fib.elKV _ _ _ hamem
  have hbkv := hbty.fib.elKV _ _ _ hbmem
  refine ⟨?_, fun k f => ?_, hsTy, hsnat⟩
  · rw [hsem, sem_pair_of_kv hakv hbkv, mem_sigmaC hAfib hfam]
    refine ⟨_, hamem, _, ?_, rfl⟩
    rw [apZ_dat_famV _ _ _ hamem, IEnv.restr_id, TEnv.restr_id_of_kv hp.kv, ← sem_inst hanat]
    exact hbmem
  · rw [sem_pair_of_kv (by rw [hanat k f]; exact isKV_res _ _) (by rw [hbnat k f]; exact isKV_res _ _),
      sem_pair_of_kv hakv hbkv, res_pairV, hanat k f, hbnat k f]

theorem sem_HasTy_fst {S : Sig} {Ψ Φ Γ A B p}
    (h0 : SemTy S Ψ Φ Γ p (sigma A B)) :
    SemTy S Ψ Φ Γ (fst p) A := by
  refine ⟨h0.1, h0.2.1, h0.2.2.1.1, fun m ρ γ hp => ?_⟩
  obtain ⟨hpmem, hpnat, hsTy, hsnat⟩ := h0.2.2.2 m ρ γ hp
  obtain ⟨hAkv, hsem, hAfib, hfam, l, hl, hV, hAWF, hAV, -⟩ := hsTy.sigma_data
  rw [hsem] at hpmem
  have heta := sigma_eta hAfib hfam hpmem
  refine ⟨heta.2.1, fun k f => ?_, ⟨l, hl, Or.inl ⟨hAWF, hAV⟩⟩, fun k f => ?_⟩
  · rw [sem_fst, sem_fst, hpnat k f]
    exact sigma_fst_res hAfib hfam hpmem f
  · obtain ⟨hAkv', hsem', -⟩ := (h0.2.2.2 k _ _ (hp.restr h0.1 f)).2.2.1.sigma_data
    have := hsnat k f
    rw [hsem', hsem, res_sigmaC] at this
    exact (sigmaC_inj hAkv' (isKV_famV _ _) (isKV_res _ _) (isKV_res _ _) this).1

theorem sem_HasTy_snd {S : Sig} {Ψ Φ Γ A B p}
    (h0 : SemTy S Ψ Φ Γ p (sigma A B)) :
    SemTy S Ψ Φ Γ (snd p) (B.inst (fst p)) := by
  refine ⟨h0.1, h0.2.1, h0.2.2.1.2.inst h0.2.1, fun m ρ γ hp => ?_⟩
  obtain ⟨hpmem, hpnat, hsTy, hsnat⟩ := h0.2.2.2 m ρ γ hp
  obtain ⟨hAkv, hsem, hAfib, hfam, l, hl, hV, hAWF, hAV, hfamV⟩ := hsTy.sigma_data
  rw [hsem] at hpmem
  have heta := sigma_eta hAfib hfam hpmem
  have hfnat : Natural S (fst p) m ρ γ := fun k f => by
    rw [sem_fst, sem_fst, hpnat k f]; exact sigma_fst_res hAfib hfam hpmem f
  have hBi : sem S (B.inst (fst p)) m ρ γ = apZ (dat (famV m (sem S A m ρ γ) fun k f a =>
      sem S B k (ρ.restr f) (TEnv.cons (TEnv.restr γ f) a)) m (Hom.id m)) (fstV m (sem S p m ρ γ)) := by
    rw [apZ_dat_famV _ _ _ heta.2.1, sem_inst hfnat, IEnv.restr_id, TEnv.restr_id_of_kv hp.kv]; rfl
  refine ⟨?_, fun k f => ?_, ?_, fun k f => ?_⟩
  · rw [sem_snd, hBi]; exact heta.2.2
  · rw [sem_snd, sem_snd, hpnat k f]; exact sigma_snd_res hAfib hfam hpmem f
  · unfold TyOK; rw [hBi]
    exact ⟨l, hl, Or.inl ⟨(hfamV _ heta.2.1).2, (hfamV _ heta.2.1).1⟩⟩
  · have hga : res f (fstV m (sem S p m ρ γ)) ∈ El (sem S A m ρ γ) f := by
      have := hAfib.elRes _ _ _ heta.2.1 k f; rwa [Hom.id_comp] at this
    rw [sem_inst (hfnat.restr f), hBi, hfam.coh m _ _ heta.2.1 k f, Hom.id_comp, apZ_dat_famV _ _ _ hga,
      hfnat k f, sem_fst]

