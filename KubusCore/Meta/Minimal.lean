import KubusCore.Meta.Defs

/-!
# Metatheory: the minimal judgments

GENERATED by `KubusCore/Meta/scripts/gen_minimal.py` from `KubusCore/Rules.lean`; do not edit.

`Wf0`, `HasTy0`, `HasTele0`, `EqTele0`, `EqTm0` are the spec's judgments without the
primitive structural rules (`wk`, `dwk`, `subst`, `dsubst`), presupposition (`eqL`, `eqR`)
and inversion of type formers (`piDom`, `piCod`, `sigmaDom`, `sigmaCod`, `pathLine`,
`pathLeft`, `pathRight`, `ipiLine`, `glueFib`). All other rules are copied literally, except
for the changes M1–M6 documented in `docs/metatheory.md`, and two anonymous substitutions in
`elimHcomp`, `transpHcomp` are named (`consSub`, `skip1I`; definitionally the same):

- M1 `HasTy0.ipi`, `EqTm0.ipi`: the context is well-formed (`Wf0` premise).
- M2 `HasTy0.glueEl`: the equivalence is typed (premise).
- M3 `EqTm0.face`: the type is a type (premise); `EqTm0.faceU` for the face rule at a universe.
- M4 `EqTm0.glueEl`, `EqTm0.unglue`: congruence also in the equivalence.
- M5 `EqTm0.transpGlue`: `∀i. φ` up to equivalence of cofibrations.
- M6 `HasTy0.con`, `HasTy0.elim`: the parameters match the parameter telescope (premise).
-/

namespace KubusCore.Meta

open Tm

mutual

inductive Wf0 (S : Sig) : Nat → I → Ctx → Prop
  | nil {Ψ Φ} : Φ.Scoped Ψ → Wf0 S Ψ Φ []
  | cons {Ψ Φ Γ A l} : HasTy0 S Ψ Φ Γ A (univ l) → Wf0 S Ψ Φ (A :: Γ)

inductive HasTy0 (S : Sig) : Nat → I → Ctx → Tm → Tm → Prop
  /- structural -/
  | var {Ψ Φ Γ x A} : Wf0 S Ψ Φ Γ → Γ.lookup x = some A → HasTy0 S Ψ Φ Γ (var x) A
  | conv {Ψ Φ Γ t A B l} : HasTy0 S Ψ Φ Γ t A → EqTm0 S Ψ Φ Γ A B (univ l) → HasTy0 S Ψ Φ Γ t B
  | restrict {Ψ Φ Φ' Γ t A} : Φ'.Scoped Ψ → I.Entails Φ' Φ → HasTy0 S Ψ Φ Γ t A → HasTy0 S Ψ Φ' Γ t A
  | const {Ψ Φ Γ k t A} : Wf0 S Ψ Φ Γ → S[k]? = some (.defn t A) → HasTy0 S Ψ Φ Γ (const k) A
  | univ {Ψ Φ Γ l} : l + 1 ≤ maxLevel → Wf0 S Ψ Φ Γ → HasTy0 S Ψ Φ Γ (univ l) (univ (l + 1))
  | cumul {Ψ Φ Γ A l} : l + 1 ≤ maxLevel → HasTy0 S Ψ Φ Γ A (univ l) → HasTy0 S Ψ Φ Γ A (univ (l + 1))
  /- Π -/
  | pi {Ψ Φ Γ A B l} : HasTy0 S Ψ Φ Γ A (univ l) → HasTy0 S Ψ Φ (A :: Γ) B (univ l) →
      HasTy0 S Ψ Φ Γ (pi A B) (univ l)
  | lam {Ψ Φ Γ A B t l} : HasTy0 S Ψ Φ Γ (pi A B) (univ l) → HasTy0 S Ψ Φ (A :: Γ) t B →
      HasTy0 S Ψ Φ Γ (lam A t) (pi A B)
  | app {Ψ Φ Γ A B f a} : HasTy0 S Ψ Φ Γ f (pi A B) → HasTy0 S Ψ Φ Γ a A →
      HasTy0 S Ψ Φ Γ (app f a) (B.inst a)
  /- Σ -/
  | sigma {Ψ Φ Γ A B l} : HasTy0 S Ψ Φ Γ A (univ l) → HasTy0 S Ψ Φ (A :: Γ) B (univ l) →
      HasTy0 S Ψ Φ Γ (sigma A B) (univ l)
  | pair {Ψ Φ Γ A B a b l} : HasTy0 S Ψ Φ Γ (sigma A B) (univ l) → HasTy0 S Ψ Φ Γ a A →
      HasTy0 S Ψ Φ Γ b (B.inst a) → HasTy0 S Ψ Φ Γ (pair a b) (sigma A B)
  | fst {Ψ Φ Γ A B p} : HasTy0 S Ψ Φ Γ p (sigma A B) → HasTy0 S Ψ Φ Γ (fst p) A
  | snd {Ψ Φ Γ A B p} : HasTy0 S Ψ Φ Γ p (sigma A B) → HasTy0 S Ψ Φ Γ (snd p) (B.inst (fst p))
  /- paths -/
  | path {Ψ Φ Γ A a b l} : HasTy0 S (Ψ + 1) Φ.shift Γ.dshift A (univ l) →
      HasTy0 S Ψ Φ Γ a (A.dinst .zero) → HasTy0 S Ψ Φ Γ b (A.dinst .one) →
      HasTy0 S Ψ Φ Γ (path A a b) (univ l)
  | plam {Ψ Φ Γ A a b t l} : HasTy0 S Ψ Φ Γ (path A a b) (univ l) →
      HasTy0 S (Ψ + 1) Φ.shift Γ.dshift t A →
      EqTm0 S Ψ Φ Γ (t.dinst .zero) a (A.dinst .zero) → EqTm0 S Ψ Φ Γ (t.dinst .one) b (A.dinst .one) →
      HasTy0 S Ψ Φ Γ (plam t) (path A a b)
  | papp {Ψ Φ Γ A a b p r} : HasTy0 S Ψ Φ Γ p (path A a b) → r.Scoped Ψ →
      HasTy0 S Ψ Φ Γ (papp p r) (A.dinst r)
  | ipi {Ψ Φ Γ A l} : Wf0 S Ψ Φ Γ → HasTy0 S (Ψ + 1) Φ.shift Γ.dshift A (univ l) →
      HasTy0 S Ψ Φ Γ (ipi A) (univ l)
  | ilam {Ψ Φ Γ A t l} : HasTy0 S Ψ Φ Γ (ipi A) (univ l) → HasTy0 S (Ψ + 1) Φ.shift Γ.dshift t A →
      HasTy0 S Ψ Φ Γ (plam t) (ipi A)
  | iapp {Ψ Φ Γ A p r} : HasTy0 S Ψ Φ Γ p (ipi A) → r.Scoped Ψ → HasTy0 S Ψ Φ Γ (papp p r) (A.dinst r)
  /- systems -/
  | split {Ψ Φ Γ A φ ψ t u l} : φ.Scoped Ψ → ψ.Scoped Ψ → I.Entails Φ (.or φ ψ) →
      HasTy0 S Ψ Φ Γ A (univ l) →
      HasTy0 S Ψ (cof Φ φ) Γ t A → HasTy0 S Ψ (cof Φ ψ) Γ u A → EqTm0 S Ψ (cof (cof Φ φ) ψ) Γ t u A →
      HasTy0 S Ψ Φ Γ (split φ t ψ u) A
  | abort {Ψ Φ Γ A l} : I.Entails Φ .zero → HasTy0 S Ψ Φ Γ A (univ l) → HasTy0 S Ψ Φ Γ abort A
  /- Kan operations -/
  | transp {Ψ Φ Γ A φ a l} : HasTy0 S (Ψ + 1) Φ.shift Γ.dshift A (univ l) → φ.Scoped Ψ →
      EqTm0 S (Ψ + 1) (cof Φ φ).shift Γ.dshift A (A.dinst .zero).dshift (univ l) →
      HasTy0 S Ψ Φ Γ a (A.dinst .zero) → HasTy0 S Ψ Φ Γ (transp A φ a) (A.dinst .one)
  | hcomp {Ψ Φ Γ A φ u a l} : HasTy0 S Ψ Φ Γ A (univ l) → φ.Scoped Ψ →
      HasTy0 S (Ψ + 1) (cof Φ φ).shift Γ.dshift u A.dshift → HasTy0 S Ψ Φ Γ a A →
      EqTm0 S Ψ (cof Φ φ) Γ (u.dinst .zero) a A → HasTy0 S Ψ Φ Γ (hcomp A φ u a) A
  /- Glue -/
  | glue {Ψ Φ Γ A φ T e l} : HasTy0 S Ψ Φ Γ A (univ l) → φ.Scoped Ψ →
      HasTy0 S Ψ (cof Φ φ) Γ T (univ l) → HasTy0 S Ψ (cof Φ φ) Γ e (equiv T A) →
      HasTy0 S Ψ Φ Γ (glue A φ T e) (univ l)
  | glueEl {Ψ Φ Γ A φ T e t a l} : HasTy0 S Ψ Φ Γ (glue A φ T e) (univ l) →
      HasTy0 S Ψ (cof Φ φ) Γ e (equiv T A) → HasTy0 S Ψ (cof Φ φ) Γ t T → HasTy0 S Ψ Φ Γ a A → EqTm0 S Ψ (cof Φ φ) Γ (app (fst e) t) a A →
      HasTy0 S Ψ Φ Γ (glueEl φ e t a) (glue A φ T e)
  | unglue {Ψ Φ Γ A φ T e g l} : HasTy0 S Ψ Φ Γ (glue A φ T e) (univ l) →
      HasTy0 S Ψ Φ Γ A (univ l) → HasTy0 S Ψ (cof Φ φ) Γ e (equiv T A) →
      HasTy0 S Ψ Φ Γ g (glue A φ T e) → HasTy0 S Ψ Φ Γ (unglue φ e g) A

  /- inductive types -/
  | data {Ψ Φ Γ d D ps} : S[d]? = some (.data D) → D.level + 1 ≤ maxLevel →
      HasTele0 S Ψ Φ Γ ps D.params [] → HasTy0 S Ψ Φ Γ (data d ps) (univ D.level)
  | con {Ψ Φ Γ d D c C ps args rs} : S[d]? = some (.data D) → D.ctors[c]? = some C →
      ps = Tm.ofList ps.toList → HasTy0 S Ψ Φ Γ (data d ps) (univ D.level) →
      HasTele0 S Ψ Φ Γ ps D.params [] →
      HasTele0 S Ψ Φ Γ args (C.argTys d D.params.length) ps.toList.reverse →
      rs.length = C.dims → (∀ r ∈ rs, r.Scoped Ψ) →
      HasTy0 S Ψ Φ Γ (con d c ps args rs) (data d ps)
  | elim {Ψ Φ Γ d D ps P bs t m} : S[d]? = some (.data D) →
      ps = Tm.ofList ps.toList →
      HasTy0 S Ψ Φ Γ (data d ps) (univ D.level) → HasTele0 S Ψ Φ Γ ps D.params [] →
      HasTy0 S Ψ Φ (data d ps :: Γ) P (univ m) →
      bs = Tm.ofList bs.toList → bs.toList.length = D.ctors.length →
      (∀ (c : Nat) (C : Ctor) (b : Tm), D.ctors[c]? = some C → bs.toList[c]? = some b →
        HasTy0 S Ψ Φ Γ b (D.branchTy d c C ps P)) →
      (∀ (c : Nat) (C : Ctor) (b : Tm) (k : Nat) (ψ : I) (e : Tm), D.ctors[c]? = some C → bs.toList[c]? = some b → C.bnd[k]? = some (ψ, e) →
        EqTm0 S (Ψ + C.dims) (cof (Φ.ren (· + C.dims)) ψ) (D.branchCtx d C ps P Γ)
          (DataDecl.branchApp C b) (D.bndElim C ps bs e) (DataDecl.branchBody d c C ps P)) →
      HasTy0 S Ψ Φ Γ t (data d ps) → HasTy0 S Ψ Φ Γ (elim d ps P bs t) (P.inst t)

/-- `as : Δ`: the list term `as` matches the telescope `Δ`, whose types are instantiated by
`prev` (the earlier elements and the outer instantiation, most recent first). -/
inductive HasTele0 (S : Sig) : Nat → I → Ctx → Tm → List Tm → List Tm → Prop
  | nil {Ψ Φ Γ prev} : Wf0 S Ψ Φ Γ → HasTele0 S Ψ Φ Γ .tnil [] prev
  | cons {Ψ Φ Γ a as A Δ prev} : HasTy0 S Ψ Φ Γ a (A.substList prev) →
      HasTele0 S Ψ Φ Γ as Δ (a :: prev) → HasTele0 S Ψ Φ Γ (.tcons a as) (A :: Δ) prev

/-- Equality of list terms in a telescope. -/
inductive EqTele0 (S : Sig) : Nat → I → Ctx → Tm → Tm → List Tm → List Tm → Prop
  | nil {Ψ Φ Γ prev} : Wf0 S Ψ Φ Γ → EqTele0 S Ψ Φ Γ .tnil .tnil [] prev
  | cons {Ψ Φ Γ a a' as as' A Δ prev} : EqTm0 S Ψ Φ Γ a a' (A.substList prev) →
      EqTele0 S Ψ Φ Γ as as' Δ (a :: prev) → EqTele0 S Ψ Φ Γ (.tcons a as) (.tcons a' as') (A :: Δ) prev

inductive EqTm0 (S : Sig) : Nat → I → Ctx → Tm → Tm → Tm → Prop
  /- equivalence and structure -/
  | refl {Ψ Φ Γ t A} : HasTy0 S Ψ Φ Γ t A → EqTm0 S Ψ Φ Γ t t A
  | symm {Ψ Φ Γ t u A} : EqTm0 S Ψ Φ Γ t u A → EqTm0 S Ψ Φ Γ u t A
  | trans {Ψ Φ Γ t u v A} : EqTm0 S Ψ Φ Γ t u A → EqTm0 S Ψ Φ Γ u v A → EqTm0 S Ψ Φ Γ t v A
  | conv {Ψ Φ Γ t u A B l} : EqTm0 S Ψ Φ Γ t u A → EqTm0 S Ψ Φ Γ A B (univ l) → EqTm0 S Ψ Φ Γ t u B
  | restrict {Ψ Φ Φ' Γ t u A} : Φ'.Scoped Ψ → I.Entails Φ' Φ → EqTm0 S Ψ Φ Γ t u A →
      EqTm0 S Ψ Φ' Γ t u A
  | cumul {Ψ Φ Γ A B l} : l + 1 ≤ maxLevel → EqTm0 S Ψ Φ Γ A B (univ l) →
      EqTm0 S Ψ Φ Γ A B (univ (l + 1))
  | delta {Ψ Φ Γ k t A} : HasTy0 S Ψ Φ Γ (const k) A → S[k]? = some (.defn t A) →
      EqTm0 S Ψ Φ Γ (const k) t A
  /- cofibrations -/
  | absurd {Ψ Φ Γ t u A} : I.Entails Φ .zero → HasTy0 S Ψ Φ Γ t A → HasTy0 S Ψ Φ Γ u A →
      EqTm0 S Ψ Φ Γ t u A
  | local {Ψ Φ Γ φ ψ t u A} : φ.Scoped Ψ → ψ.Scoped Ψ → I.Entails Φ (.or φ ψ) →
      HasTy0 S Ψ Φ Γ t A → HasTy0 S Ψ Φ Γ u A →
      EqTm0 S Ψ (cof Φ φ) Γ t u A → EqTm0 S Ψ (cof Φ ψ) Γ t u A → EqTm0 S Ψ Φ Γ t u A
  | face {Ψ Φ Γ t A i d l} : i < Ψ → I.Entails Φ (I.lit i d) → HasTy0 S Ψ Φ Γ A (univ l) →
      HasTy0 S Ψ Φ Γ t A → EqTm0 S Ψ Φ Γ t (t.dset i (I.ofDir d)) A
  | faceU {Ψ Φ Γ t i d l} : i < Ψ → I.Entails Φ (I.lit i d) → HasTy0 S Ψ Φ Γ t (univ l) →
      EqTm0 S Ψ Φ Γ t (t.dset i (I.ofDir d)) (univ l)
  /- congruence -/
  | pi {Ψ Φ Γ A A' B B' l} : EqTm0 S Ψ Φ Γ A A' (univ l) → EqTm0 S Ψ Φ (A :: Γ) B B' (univ l) →
      EqTm0 S Ψ Φ Γ (pi A B) (pi A' B') (univ l)
  | lam {Ψ Φ Γ A B t t' l} : HasTy0 S Ψ Φ Γ (pi A B) (univ l) → EqTm0 S Ψ Φ (A :: Γ) t t' B →
      EqTm0 S Ψ Φ Γ (lam A t) (lam A t') (pi A B)
  | app {Ψ Φ Γ A B f f' a a'} : EqTm0 S Ψ Φ Γ f f' (pi A B) → EqTm0 S Ψ Φ Γ a a' A →
      EqTm0 S Ψ Φ Γ (app f a) (app f' a') (B.inst a)
  | sigma {Ψ Φ Γ A A' B B' l} : EqTm0 S Ψ Φ Γ A A' (univ l) → EqTm0 S Ψ Φ (A :: Γ) B B' (univ l) →
      EqTm0 S Ψ Φ Γ (sigma A B) (sigma A' B') (univ l)
  | pair {Ψ Φ Γ A B a a' b b' l} : HasTy0 S Ψ Φ Γ (sigma A B) (univ l) → EqTm0 S Ψ Φ Γ a a' A →
      EqTm0 S Ψ Φ Γ b b' (B.inst a) → EqTm0 S Ψ Φ Γ (pair a b) (pair a' b') (sigma A B)
  | fst {Ψ Φ Γ A B p p'} : EqTm0 S Ψ Φ Γ p p' (sigma A B) → EqTm0 S Ψ Φ Γ (fst p) (fst p') A
  | snd {Ψ Φ Γ A B p p'} : EqTm0 S Ψ Φ Γ p p' (sigma A B) →
      EqTm0 S Ψ Φ Γ (snd p) (snd p') (B.inst (fst p))
  | path {Ψ Φ Γ A A' a a' b b' l} : EqTm0 S (Ψ + 1) Φ.shift Γ.dshift A A' (univ l) →
      EqTm0 S Ψ Φ Γ a a' (A.dinst .zero) → EqTm0 S Ψ Φ Γ b b' (A.dinst .one) →
      EqTm0 S Ψ Φ Γ (path A a b) (path A' a' b') (univ l)
  | plam {Ψ Φ Γ A a b t t' l} : HasTy0 S Ψ Φ Γ (path A a b) (univ l) →
      HasTy0 S Ψ Φ Γ (plam t) (path A a b) → HasTy0 S Ψ Φ Γ (plam t') (path A a b) →
      EqTm0 S (Ψ + 1) Φ.shift Γ.dshift t t' A → EqTm0 S Ψ Φ Γ (plam t) (plam t') (path A a b)
  | papp {Ψ Φ Γ A a b p p' r r'} : EqTm0 S Ψ Φ Γ p p' (path A a b) → r.Scoped Ψ → r'.Scoped Ψ →
      I.Eq r r' → EqTm0 S Ψ Φ Γ (papp p r) (papp p' r') (A.dinst r)
  | split {Ψ Φ Γ A φ ψ t t' u u'} : HasTy0 S Ψ Φ Γ (split φ t ψ u) A →
      HasTy0 S Ψ Φ Γ (split φ t' ψ u') A →
      EqTm0 S Ψ (cof Φ φ) Γ t t' A → EqTm0 S Ψ (cof Φ ψ) Γ u u' A →
      EqTm0 S Ψ Φ Γ (split φ t ψ u) (split φ t' ψ u') A
  | transp {Ψ Φ Γ A A' φ φ' a a' l} : HasTy0 S Ψ Φ Γ (transp A φ a) (A.dinst .one) →
      HasTy0 S Ψ Φ Γ (transp A' φ' a') (A.dinst .one) →
      EqTm0 S (Ψ + 1) Φ.shift Γ.dshift A A' (univ l) → I.Entails φ φ' → I.Entails φ' φ →
      EqTm0 S Ψ Φ Γ a a' (A.dinst .zero) → EqTm0 S Ψ Φ Γ (transp A φ a) (transp A' φ' a') (A.dinst .one)
  | hcomp {Ψ Φ Γ A A' φ φ' u u' a a' l} : HasTy0 S Ψ Φ Γ (hcomp A φ u a) A →
      HasTy0 S Ψ Φ Γ (hcomp A' φ' u' a') A → EqTm0 S Ψ Φ Γ A A' (univ l) →
      I.Entails φ φ' → I.Entails φ' φ →
      EqTm0 S (Ψ + 1) (cof Φ φ).shift Γ.dshift u u' A.dshift → EqTm0 S Ψ Φ Γ a a' A →
      EqTm0 S Ψ Φ Γ (hcomp A φ u a) (hcomp A' φ' u' a') A
  | glue {Ψ Φ Γ A A' φ φ' T T' e e' l} : HasTy0 S Ψ Φ Γ (glue A φ T e) (univ l) →
      HasTy0 S Ψ Φ Γ (glue A' φ' T' e') (univ l) → EqTm0 S Ψ Φ Γ A A' (univ l) →
      I.Entails φ φ' → I.Entails φ' φ →
      EqTm0 S Ψ (cof Φ φ) Γ T T' (univ l) → EqTm0 S Ψ (cof Φ φ) Γ e e' (equiv T A) →
      EqTm0 S Ψ Φ Γ (glue A φ T e) (glue A' φ' T' e') (univ l)
  | glueEl {Ψ Φ Γ φ φ' t t' a a' A T e e'} : HasTy0 S Ψ Φ Γ (glueEl φ e t a) (glue A φ T e) →
      HasTy0 S Ψ Φ Γ (glueEl φ' e' t' a') (glue A φ T e) →
      I.Entails φ φ' → I.Entails φ' φ → EqTm0 S Ψ (cof Φ φ) Γ e e' (equiv T A) →
      EqTm0 S Ψ (cof Φ φ) Γ t t' T → EqTm0 S Ψ Φ Γ a a' A →
      EqTm0 S Ψ Φ Γ (glueEl φ e t a) (glueEl φ' e' t' a') (glue A φ T e)
  | unglue {Ψ Φ Γ A φ φ' T e e' g g'} : HasTy0 S Ψ Φ Γ (unglue φ e g) A →
      HasTy0 S Ψ Φ Γ (unglue φ' e' g') A →
      I.Entails φ φ' → I.Entails φ' φ → EqTm0 S Ψ (cof Φ φ) Γ e e' (equiv T A) →
      EqTm0 S Ψ Φ Γ g g' (glue A φ T e) → EqTm0 S Ψ Φ Γ (unglue φ e g) (unglue φ' e' g') A
  | ipi {Ψ Φ Γ A A' l} : Wf0 S Ψ Φ Γ → EqTm0 S (Ψ + 1) Φ.shift Γ.dshift A A' (univ l) →
      EqTm0 S Ψ Φ Γ (ipi A) (ipi A') (univ l)
  | ilam {Ψ Φ Γ A t t' l} : HasTy0 S Ψ Φ Γ (ipi A) (univ l) →
      EqTm0 S (Ψ + 1) Φ.shift Γ.dshift t t' A → EqTm0 S Ψ Φ Γ (plam t) (plam t') (ipi A)
  | iapp {Ψ Φ Γ A p p' r r'} : EqTm0 S Ψ Φ Γ p p' (ipi A) → r.Scoped Ψ → r'.Scoped Ψ →
      I.Eq r r' → EqTm0 S Ψ Φ Γ (papp p r) (papp p' r') (A.dinst r)
  /- β and η -/
  | piBeta {Ψ Φ Γ A t a T} : HasTy0 S Ψ Φ Γ (app (lam A t) a) T →
      EqTm0 S Ψ Φ Γ (app (lam A t) a) (t.inst a) T
  | piEta {Ψ Φ Γ A B f} : HasTy0 S Ψ Φ Γ f (pi A B) →
      EqTm0 S Ψ Φ Γ f (lam A (app f.shift (var 0))) (pi A B)
  | fstBeta {Ψ Φ Γ a b T} : HasTy0 S Ψ Φ Γ (fst (pair a b)) T → EqTm0 S Ψ Φ Γ (fst (pair a b)) a T
  | sndBeta {Ψ Φ Γ a b T} : HasTy0 S Ψ Φ Γ (snd (pair a b)) T → EqTm0 S Ψ Φ Γ (snd (pair a b)) b T
  | sigmaEta {Ψ Φ Γ A B p} : HasTy0 S Ψ Φ Γ p (sigma A B) →
      EqTm0 S Ψ Φ Γ p (pair (fst p) (snd p)) (sigma A B)
  | pathBeta {Ψ Φ Γ t r T} : HasTy0 S Ψ Φ Γ (papp (plam t) r) T →
      EqTm0 S Ψ Φ Γ (papp (plam t) r) (t.dinst r) T
  | pathEta {Ψ Φ Γ A a b p} : HasTy0 S Ψ Φ Γ p (path A a b) →
      EqTm0 S Ψ Φ Γ p (plam (papp p.dshift (.var 0))) (path A a b)
  | ipiEta {Ψ Φ Γ A p} : HasTy0 S Ψ Φ Γ p (ipi A) →
      EqTm0 S Ψ Φ Γ p (plam (papp p.dshift (.var 0))) (ipi A)
  | pathZero {Ψ Φ Γ A a b p} : HasTy0 S Ψ Φ Γ p (path A a b) →
      EqTm0 S Ψ Φ Γ (papp p .zero) a (A.dinst .zero)
  | pathOne {Ψ Φ Γ A a b p} : HasTy0 S Ψ Φ Γ p (path A a b) →
      EqTm0 S Ψ Φ Γ (papp p .one) b (A.dinst .one)
  /- systems -/
  | splitL {Ψ Φ Γ φ ψ t u T} : I.Entails Φ φ → HasTy0 S Ψ Φ Γ (split φ t ψ u) T →
      EqTm0 S Ψ Φ Γ (split φ t ψ u) t T
  | splitR {Ψ Φ Γ φ ψ t u T} : I.Entails Φ ψ → HasTy0 S Ψ Φ Γ (split φ t ψ u) T →
      EqTm0 S Ψ Φ Γ (split φ t ψ u) u T
  /- Kan operations: boundaries -/
  | transpFace {Ψ Φ Γ A φ a T} : I.Entails Φ φ → HasTy0 S Ψ Φ Γ (transp A φ a) T →
      EqTm0 S Ψ Φ Γ (transp A φ a) a T
  | hcompFace {Ψ Φ Γ A φ u a T} : I.Entails Φ φ → HasTy0 S Ψ Φ Γ (hcomp A φ u a) T →
      EqTm0 S Ψ Φ Γ (hcomp A φ u a) (u.dinst .one) T
  /- Kan operations: computation (Coquand–Huber–Mörtberg) -/
  | transpU {Ψ Φ Γ l φ a T} : HasTy0 S Ψ Φ Γ (transp (univ l) φ a) T →
      EqTm0 S Ψ Φ Γ (transp (univ l) φ a) a T
  | transpPi {Ψ Φ Γ A B φ u0 T} : HasTy0 S Ψ Φ Γ (transp (pi A B) φ u0) T →
      EqTm0 S Ψ Φ Γ (transp (pi A B) φ u0) (transpPi A B φ u0) T
  | transpSigma {Ψ Φ Γ A B φ u0 T} : HasTy0 S Ψ Φ Γ (transp (sigma A B) φ u0) T →
      EqTm0 S Ψ Φ Γ (transp (sigma A B) φ u0) (transpSigma A B φ u0) T
  | transpPath {Ψ Φ Γ A a b φ p0 T} : HasTy0 S Ψ Φ Γ (transp (path A a b) φ p0) T →
      EqTm0 S Ψ Φ Γ (transp (path A a b) φ p0) (transpPath A a b φ p0) T
  | transpGlue {Ψ Φ Γ A φ T' e ψ u0 T l δ} : HasTy0 S Ψ Φ Γ (transp (glue A φ T' e) ψ u0) T →
      HasTy0 S (Ψ + 1) Φ.shift Γ.dshift A (univ l) →
      HasTy0 S (Ψ + 1) (cof Φ.shift φ) Γ.dshift e (equiv T' A) →
      I.Entails δ φ.forall0 → I.Entails φ.forall0 δ →
      EqTm0 S Ψ Φ Γ (transp (glue A φ T' e) ψ u0) (transpGlueWith δ A φ T' e ψ u0) T
  | transpIPi {Ψ Φ Γ A φ u0 T} : HasTy0 S Ψ Φ Γ (transp (ipi A) φ u0) T →
      EqTm0 S Ψ Φ Γ (transp (ipi A) φ u0) (transpIPi A φ u0) T
  | hcompIPi {Ψ Φ Γ A φ u u0 T} : HasTy0 S Ψ Φ Γ (hcomp (ipi A) φ u u0) T →
      EqTm0 S Ψ Φ Γ (hcomp (ipi A) φ u u0) (hcompIPi A φ u u0) T
  | hcompPi {Ψ Φ Γ A B φ u u0 T} : HasTy0 S Ψ Φ Γ (hcomp (pi A B) φ u u0) T →
      EqTm0 S Ψ Φ Γ (hcomp (pi A B) φ u u0) (hcompPi A B φ u u0) T
  | hcompSigma {Ψ Φ Γ A B φ u u0 T} : HasTy0 S Ψ Φ Γ (hcomp (sigma A B) φ u u0) T →
      EqTm0 S Ψ Φ Γ (hcomp (sigma A B) φ u u0) (hcompSigma A B φ u u0) T
  | hcompPath {Ψ Φ Γ A a b φ u p0 T} : HasTy0 S Ψ Φ Γ (hcomp (path A a b) φ u p0) T →
      EqTm0 S Ψ Φ Γ (hcomp (path A a b) φ u p0) (hcompPath A a b φ u p0) T
  | hcompGlue {Ψ Φ Γ A φ T' e ψ u u0 T l} : HasTy0 S Ψ Φ Γ (hcomp (glue A φ T' e) ψ u u0) T →
      HasTy0 S Ψ Φ Γ A (univ l) → HasTy0 S Ψ (cof Φ φ) Γ e (equiv T' A) →
      EqTm0 S Ψ Φ Γ (hcomp (glue A φ T' e) ψ u u0) (hcompGlue A φ T' e ψ u u0) T
  | hcompU {Ψ Φ Γ φ u u0 T l} : HasTy0 S Ψ Φ Γ (hcomp (univ l) φ u u0) T →
      EqTm0 S Ψ Φ Γ (hcomp (univ l) φ u u0) (hcompU φ u u0) T
  /- Glue -/
  | glueFace {Ψ Φ Γ A φ T e G} : I.Entails Φ φ → HasTy0 S Ψ Φ Γ (glue A φ T e) G →
      EqTm0 S Ψ Φ Γ (glue A φ T e) T G
  | glueElFace {Ψ Φ Γ φ e t a G} : I.Entails Φ φ → HasTy0 S Ψ Φ Γ (glueEl φ e t a) G →
      EqTm0 S Ψ Φ Γ (glueEl φ e t a) t G
  | unglueFace {Ψ Φ Γ A φ T e g l} : I.Entails Φ φ → HasTy0 S Ψ Φ Γ g (glue A φ T e) →
      HasTy0 S Ψ Φ Γ A (univ l) → HasTy0 S Ψ Φ Γ e (equiv T A) →
      EqTm0 S Ψ Φ Γ (unglue φ e g) (app (fst e) g) A
  | glueBeta {Ψ Φ Γ φ e t a G} : HasTy0 S Ψ Φ Γ (unglue φ e (glueEl φ e t a)) G →
      EqTm0 S Ψ Φ Γ (unglue φ e (glueEl φ e t a)) a G
  | glueEta {Ψ Φ Γ A φ T e g} : HasTy0 S Ψ Φ Γ g (glue A φ T e) →
      EqTm0 S Ψ Φ Γ g (glueEl φ e g (unglue φ e g)) (glue A φ T e)
  /- inductive types: congruence -/
  | data {Ψ Φ Γ d D ps ps'} : S[d]? = some (.data D) →
      HasTy0 S Ψ Φ Γ (data d ps) (univ D.level) → HasTy0 S Ψ Φ Γ (data d ps') (univ D.level) →
      EqTele0 S Ψ Φ Γ ps ps' D.params [] → EqTm0 S Ψ Φ Γ (data d ps) (data d ps') (univ D.level)
  | con {Ψ Φ Γ d D c C ps ps' args args' rs rs'} : S[d]? = some (.data D) → D.ctors[c]? = some C →
      HasTy0 S Ψ Φ Γ (con d c ps args rs) (data d ps) →
      HasTy0 S Ψ Φ Γ (con d c ps' args' rs') (data d ps) →
      EqTele0 S Ψ Φ Γ ps ps' D.params [] →
      EqTele0 S Ψ Φ Γ args args' (C.argTys d D.params.length) ps.toList.reverse →
      rs.length = rs'.length → (∀ (k : Nat) (r r' : I), rs[k]? = some r → rs'[k]? = some r' → I.Eq r r') →
      EqTm0 S Ψ Φ Γ (con d c ps args rs) (con d c ps' args' rs') (data d ps)
  | elim {Ψ Φ Γ d D ps ps' P P' bs bs' t t' m} : S[d]? = some (.data D) →
      HasTy0 S Ψ Φ Γ (elim d ps P bs t) (P.inst t) → HasTy0 S Ψ Φ Γ (elim d ps' P' bs' t') (P.inst t) →
      EqTele0 S Ψ Φ Γ ps ps' D.params [] → EqTm0 S Ψ Φ (data d ps :: Γ) P P' (univ m) →
      bs.toList.length = bs'.toList.length →
      (∀ (c : Nat) (C : Ctor) (b b' : Tm), D.ctors[c]? = some C → bs.toList[c]? = some b →
        bs'.toList[c]? = some b' →
        EqTm0 S Ψ Φ Γ b b' (D.branchTy d c C ps P)) →
      EqTm0 S Ψ Φ Γ t t' (data d ps) →
      EqTm0 S Ψ Φ Γ (elim d ps P bs t) (elim d ps' P' bs' t') (P.inst t)
  /- inductive types: boundaries of path constructors -/
  | conBnd {Ψ Φ Γ d D c C ps args rs} {k : Nat} {ψ b T} : S[d]? = some (.data D) → D.ctors[c]? = some C →
      C.bnd[k]? = some (ψ, b) → I.Entails Φ (Ctor.cofAt ψ rs) →
      ps = Tm.ofList ps.toList → args = Tm.ofList args.toList →
      HasTy0 S Ψ Φ Γ (con d c ps args rs) T →
      EqTm0 S Ψ Φ Γ (con d c ps args rs) (Ctor.bndAt b ps.toList args.toList rs) T
  /- inductive types: elimination -/
  | elimCon {Ψ Φ Γ d D c C ps P bs b qs args rs T} : S[d]? = some (.data D) →
      D.ctors[c]? = some C → bs.toList[c]? = some b →
      args = Tm.ofList args.toList → bs = Tm.ofList bs.toList →
      HasTy0 S Ψ Φ Γ (elim d ps P bs (con d c qs args rs)) T →
      EqTm0 S Ψ Φ Γ (elim d ps P bs (con d c qs args rs))
        (Tm.papps (Tm.apps b (args.toList ++
          C.recPos.map fun k => elim d ps P bs (args.toList.getD k .abort))) rs) T
  | elimHcomp {Ψ Φ Γ d D ps P bs qs φ u a T} : S[d]? = some (.data D) →
      HasTy0 S Ψ Φ Γ (elim d ps P bs (hcomp (data d qs) φ u a)) T →
      EqTm0 S Ψ Φ Γ (elim d ps P bs (hcomp (data d qs) φ u a))
        (comp (P.subst (consSub (hfill (data d ps) φ u a)) (fun i => .var (i + 1))) φ
          (elim d ps.dshift P.dshift bs.dshift u) (elim d ps P bs a)) T
  /- inductive types: transport (`hcomp` in an inductive type is a canonical form) -/
  | transpData0 {Ψ Φ Γ d D ps φ a T} : S[d]? = some (.data D) → D.params = [] →
      HasTy0 S Ψ Φ Γ (transp (data d ps) φ a) T → EqTm0 S Ψ Φ Γ (transp (data d ps) φ a) a T
  | transpCon {Ψ Φ Γ d D c C ps φ qs args rs T} : S[d]? = some (.data D) → D.params ≠ [] →
      D.ctors[c]? = some C → ps = Tm.ofList ps.toList → args = Tm.ofList args.toList →
      HasTy0 S Ψ Φ Γ (transp (data d ps) φ (con d c qs args rs)) T →
      EqTm0 S Ψ Φ Γ (transp (data d ps) φ (con d c qs args rs))
        (con d c (ps.dinst .one)
          (Tm.ofList (Tm.transpTele (C.argTy d D.params.length) ps.toList φ 0 [] args.toList)) rs) T
  | transpHcomp {Ψ Φ Γ d D ps φ qs ψ u a T} : S[d]? = some (.data D) → D.params ≠ [] →
      HasTy0 S Ψ Φ Γ (transp (data d ps) φ (hcomp (data d qs) ψ u a)) T →
      EqTm0 S Ψ Φ Γ (transp (data d ps) φ (hcomp (data d qs) ψ u a))
        (hcomp (data d (ps.dinst .one)) ψ
          (transp ((data d ps).dsubst skip1I) φ.shift u)
          (transp (data d ps) φ a)) T

end


end KubusCore.Meta
